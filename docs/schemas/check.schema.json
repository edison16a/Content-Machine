{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edison16a/Content-Machine/docs/schemas/check.schema.json",
  "title": "Content Machine check",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "checkedAt": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "ok": {
            "type": "boolean"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "duration": {
            "type": "number"
          },
          "videoCodec": {
            "type": "string"
          },
          "audioCodec": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "ok",
          "problems"
        ]
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sheets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "ok",
    "checkedAt",
    "items",
    "problems",
    "sheets"
  ]
}
