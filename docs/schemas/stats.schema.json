{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edison16a/Content-Machine/docs/schemas/stats.schema.json",
  "title": "Content Machine stats",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "platform": {
            "type": "string",
            "enum": [
              "tiktok",
              "instagram",
              "youtube"
            ]
          },
          "itemId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string"
          },
          "views": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "likes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "comments": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "shares": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "at",
          "platform",
          "itemId",
          "title",
          "views",
          "likes",
          "comments",
          "shares"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "snapshots"
  ]
}
