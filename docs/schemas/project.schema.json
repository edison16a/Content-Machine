{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edison16a/Content-Machine/docs/schemas/project.schema.json",
  "title": "Content Machine project",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "channel": {
      "default": "",
      "type": "string"
    },
    "sourcePlatform": {
      "default": "youtube",
      "type": "string",
      "enum": [
        "youtube",
        "twitch",
        "kick",
        "tiktok",
        "instagram",
        "x",
        "facebook",
        "other"
      ]
    },
    "account": {
      "default": "default",
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string"
    },
    "weekStartsOn": {
      "default": "monday",
      "type": "string",
      "enum": [
        "monday",
        "sunday"
      ]
    },
    "slots": {
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
      }
    },
    "stagger": {
      "type": "object",
      "properties": {
        "tiktok": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "instagram": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        },
        "youtube": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180
        }
      },
      "required": [
        "tiktok",
        "instagram",
        "youtube"
      ]
    },
    "handles": {
      "default": {
        "tiktok": "",
        "instagram": "",
        "youtube": ""
      },
      "type": "object",
      "properties": {
        "tiktok": {
          "default": "",
          "type": "string"
        },
        "instagram": {
          "default": "",
          "type": "string"
        },
        "youtube": {
          "default": "",
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "timezone",
    "slots",
    "stagger"
  ]
}
